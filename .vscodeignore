out/**
# Anchored `node_modules/**` only matches the root copy — client/node_modules
# (~3.9k files) shipped in the .vsix without the `**/` prefix.
**/node_modules/**
src/**
# The FigJam plugin is published separately to the Figma Community; none of it
# belongs in the extension package.
client/**
# The README's screenshot doesn't need to ship: vsce rewrites relative image
# links to raw.githubusercontent URLs at package time, so the Marketplace pulls
# it from the repo. (images/icon.png DOES ship — package.json's `icon` field
# reads it from inside the .vsix.)
images/screenshot.png
.gitignore
.yarnrc
webpack.config.js
vsc-extension-quickstart.md
package-lock.json
# Internal working docs — README/CHANGELOG are the published ones.
CLAUDE.md
BUGS.md
